---
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";
import { SITE } from "../consts";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  author?: string;
  date: Date;
  readTimeMinutes: number;
  tags?: string[];
}

const {
  title,
  description,
  keywords,
  author = SITE.authorName,
  date,
  readTimeMinutes,
  tags = [],
} = Astro.props;

const dateLabel = date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<BaseLayout
  title={`${title} | ${SITE.titleLeft}${SITE.titleRight}`}
  description={description}
  keywords={keywords}
  isArticle
  publishedTime={date}
  tags={tags}
>
  <article class="post-article container" itemscope itemtype="http://schema.org/BlogPosting">
    <h1 class="post-title" itemprop="name headline">{title}</h1>

    <div class="post-meta-bar">
      <span itemprop="author">{author}</span>
      <span>&middot;</span>
      <time datetime={date.toISOString()} itemprop="datePublished">{dateLabel}</time>
      <span>&middot;</span>
      <span>{readTimeMinutes} min read</span>
    </div>

    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <a class="tag-pill" href={`/tags/${tag}/`}>{tag}</a>
        ))}
      </div>
    )}

    <div class="post-content" itemprop="articleBody">
      <slot />
    </div>

    <div class="post-back">
      <a href="/">&larr; Back to all articles</a>
    </div>
  </article>

  <Comments />
</BaseLayout>
