---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, readingTime, type Post } from "../../lib/posts";
import { SITE } from "../../consts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tagSet = new Set<string>();
  posts.forEach((post) => post.data.tags.forEach((tag) => tagSet.add(tag)));
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}
---

<BaseLayout title={`${tag} | ${SITE.titleLeft}${SITE.titleRight}`}>
  <div class="container">
    <h2 class="post-title masthead-accent">#{tag}</h2>

    {posts.map((post) => (
      <>
        <article class="post-item">
          <div class="post-item-main">
            <h3 class="post-item-title">
              <a href={`/${post.slug}/`}>{post.data.title}</a>
            </h3>
            {post.data.description && <p class="post-item-desc">{post.data.description}</p>}
            <p class="post-item-meta">
              <span>{formatDate(post.date)}</span>
              <span class="meta-sep">&middot;</span>
              <span>{readingTime(post.body)} min read</span>
            </p>
            {post.data.tags.length > 0 && (
              <p class="post-item-tags">
                {post.data.tags.map((t) => <a class="tag-pill" href={`/tags/${t}/`}>{t}</a>)}
              </p>
            )}
          </div>
        </article>
        <hr class="post-divider" />
      </>
    ))}
  </div>
</BaseLayout>
