---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts, readingTime } from "../lib/posts";
import { SITE } from "../consts";

const posts = await getPublishedPosts();

const pageTitle = `${SITE.titleLeft}${SITE.titleRight} | ${SITE.description}`;

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

<BaseLayout title={pageTitle}>
  <div class="container">
    <div class="post-list">
      {posts.map((post) => (
        <div class="post-row">
          <span class="post-row-date">{formatDate(post.date)}</span>
          <div class="post-row-body">
            <a class="post-row-title" href={`/${post.slug}/`}>{post.data.title}</a>
            <div class="post-row-meta">
              {post.data.tags.map((tag) => (
                <a class="post-row-tag" href={`/tags/${tag}/`}>{tag}</a>
              ))}
              <span class="post-row-readtime">{readingTime(post.body)} min</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
